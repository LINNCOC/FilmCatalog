<Window x:Class="FilmCatalog.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Каталог фильмов" Height="700" Width="1000" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Каталог фильмов" FontSize="24" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <!-- Панель поиска и сортировки -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Поиск по названию:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="SearchBox" Width="250" VerticalContentAlignment="Center"
                     TextChanged="SearchBox_TextChanged"/>
            <CheckBox x:Name="SortByGenreCheck" Content="Сортировать по жанру"
                      VerticalAlignment="Center" Margin="20,0,0,0"
                      Checked="Sort_Changed" Unchecked="Sort_Changed"/>
        </StackPanel>

        <!-- DataGrid -->
        <DataGrid Grid.Row="2" x:Name="MoviesGrid" AutoGenerateColumns="False"
                  IsReadOnly="True" SelectionMode="Single"
                  CanUserAddRows="False" SelectionChanged="MoviesGrid_SelectionChanged"
                  Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Год" Binding="{Binding ReleaseYear}" Width="60"/>
                <DataGridTextColumn Header="Жанр" Binding="{Binding Genre}" Width="110"/>
                <DataGridTextColumn Header="Длит. (мин)" Binding="{Binding Duration}" Width="90"/>
                <DataGridTextColumn Header="Рейтинг" Binding="{Binding Rating}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Панель редактирования -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBox x:Name="TitleBox" Width="140" Margin="0,0,5,0" VerticalContentAlignment="Center"/>
            <TextBox x:Name="YearBox" Width="55" Margin="0,0,5,0" VerticalContentAlignment="Center"/>
            <TextBox x:Name="GenreBox" Width="90" Margin="0,0,5,0" VerticalContentAlignment="Center"/>
            <TextBox x:Name="DurationBox" Width="60" Margin="0,0,5,0" VerticalContentAlignment="Center"/>
            <TextBox x:Name="RatingBox" Width="55" Margin="0,0,5,0" VerticalContentAlignment="Center"/>
            <TextBox x:Name="DescriptionBox" Width="180" Margin="0,0,5,0" VerticalContentAlignment="Center"/>

            <Button Content="Добавить" Width="75" Margin="0,0,5,0" Click="Add_Click"/>
            <Button Content="Обновить" Width="75" Margin="0,0,5,0" Click="Update_Click"/>
            <Button Content="Удалить" Width="75" Margin="0,0,5,0" Click="Delete_Click"/>
            <Button Content="Подробнее" Width="90" Margin="0,0,5,0" Click="Details_Click"/>
            <Button Content="Обновить список" Width="120" Click="Refresh_Click"/>
        </StackPanel>
    </Grid>
</Window>