<Window x:Class="FilmCatalog.MovieDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подробности о фильме" Height="400" Width="550"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="22" FontWeight="Bold"
                   TextWrapping="Wrap" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock x:Name="YearText" Margin="0,0,15,0"/>
            <TextBlock x:Name="GenreText" Margin="0,0,15,0"/>
            <TextBlock x:Name="DurationText" Margin="0,0,15,0"/>
            <TextBlock x:Name="RatingText"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" FontSize="14"/>
        </ScrollViewer>

        <Button Grid.Row="3" Content="Закрыть" Width="100" Height="30"
                HorizontalAlignment="Right" Margin="0,10,0,0" Click="Close_Click"/>
    </Grid>
</Window>